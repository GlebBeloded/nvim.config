{
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
  "runtime.version": "LuaJIT",
  "runtime.path": ["lua/?.lua", "lua/?/init.lua", "?.lua", "?/init.lua"],
  "runtime.pathStrict": true,
  "diagnostics.globals": ["vim"],
  "diagnostics.severity": {
    "undefined-doc-name": "Information",
    "need-check-nil": "Information"
  },
  "workspace.checkThirdParty": false,
  "workspace.library": ["$VIMRUNTIME", "${3rd}/luv/library", ".tests/deps/mini.nvim"],
  "workspace.ignoreDir": [".tests", ".git", "plugin"]
}
