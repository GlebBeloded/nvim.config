#!/bin/sh
# Stand-in for the GitHub CLI in test children: never touches the network.
# FAKE_GH_LOG: append "<GH_HOST>\t<args>"; FAKE_GH_SLEEP: seconds; FAKE_GH_STDOUT: file printed on
# stdout (exit FAKE_GH_CODE, default 0); FAKE_GH_DIR: routed responses; otherwise FAKE_GH_STDERR
# (default: no pull request) and exit FAKE_GH_CODE (default 1).
[ -n "${FAKE_GH_LOG:-}" ] && printf '%s\t%s\n' "${GH_HOST:-}" "$*" >>"$FAKE_GH_LOG"
if [ -n "${FAKE_GH_SLEEP:-}" ]; then
	sleep "$FAKE_GH_SLEEP" &
	sleeper=$!
	[ -n "${FAKE_GH_PID_FILE:-}" ] && printf '%s\n' "$sleeper" >"$FAKE_GH_PID_FILE"
	trap 'kill "$sleeper" 2>/dev/null; wait "$sleeper" 2>/dev/null; exit 124' TERM INT
	wait "$sleeper"
	trap - TERM INT
fi
if [ -n "${FAKE_GH_STDOUT:-}" ]; then
	cat "$FAKE_GH_STDOUT"
	exit "${FAKE_GH_CODE:-0}"
fi
if [ -n "${FAKE_GH_DIR:-}" ]; then
	response=
	if [ "${1:-}" = pr ] && [ "${2:-}" = view ]; then
		response=pr
	elif [ "${1:-}" = api ] && [ "${2:-}" = graphql ]; then
		operation=
		cursor=
		for argument in "$@"; do
			case "$argument" in
			query=query\ *)
				operation=${argument#query=query }
				operation=${operation%%[!A-Za-z0-9_]*}
				;;
			query=mutation\ *)
				operation=${argument#query=mutation }
				operation=${operation%%[!A-Za-z0-9_]*}
				;;
			cursor=*) cursor=${argument#cursor=} ;;
			esac
		done
		response=$operation
		[ -n "$cursor" ] && response="$response-$cursor"
	fi
	file="$FAKE_GH_DIR/$response.json"
	if [ -z "$response" ] || [ ! -f "$file" ]; then
		printf 'fake gh: no response for %s\n' "${response:-unknown}" >&2
		exit 1
	fi
	[ -f "$file.stderr" ] && cat "$file.stderr" >&2
	cat "$file"
	if [ -f "$file.code" ]; then
		exit "$(cat "$file.code")"
	fi
	exit 0
fi
printf '%s\n' "${FAKE_GH_STDERR:-no pull requests found for branch \"$(git branch --show-current)\"}" >&2
exit "${FAKE_GH_CODE:-1}"
